FROM rust:1.90-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl file libwebkit2gtk-4.1-dev libappindicator3-dev \
    librsvg2-dev patchelf libssl-dev libayatana-appindicator3-dev xdg-utils \
    libgtk-3-dev javascriptcoregtk-4.1 libsoup-3.0-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global @tauri-apps/cli@^2
WORKDIR /workspace
COPY package.json vite.config.js index.html ./
RUN npm install
COPY src ./src
COPY src-tauri ./src-tauri
CMD ["sh", "-c", "npm run tauri:build && mkdir -p /workspace/bin && cp -R /workspace/src-tauri/target/release/bundle/. /workspace/bin/"]
